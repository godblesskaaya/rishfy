# notification-service environment
NODE_ENV=development
SERVICE_NAME=notification-service
HTTP_PORT=8087
GRPC_PORT=50057
LOG_LEVEL=debug

# Database (per-service isolation)
DATABASE_URL=postgres://notification_user:dev_notification_password@localhost:5432/notification_db

# Cache (dedicated Redis DB index)
REDIS_URL=redis://localhost:6379

# Event bus
KAFKA_BROKERS=localhost:29092

# Push notifications (Firebase Cloud Messaging)
# Provide either:
# 1. FIREBASE_SERVICE_ACCOUNT_JSON with the full JSON payload, or
# 2. FIREBASE_SERVICE_ACCOUNT_PATH pointing at a mounted service-account file.
# FIREBASE_PROJECT_ID is optional when the service account already includes it.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=notification-service
